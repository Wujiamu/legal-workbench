#!/bin/sh
# Finder starts apps without the interactive shell's PATH.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export LC_ALL=en_US.UTF-8

contents=$(cd "$(dirname "$0")/.." && pwd)
locator="$contents/Resources/project-root"
if [ -r "$locator" ]; then
    IFS= read -r project < "$locator"
else
    project=$(cd "$contents/../.." && pwd)
fi

if [ -x "$project/backend/.venv/bin/python" ] && [ -f "$project/scripts/lwb-launch" ]; then
    exec "$project/backend/.venv/bin/python" "$project/scripts/lwb-launch"
fi

/usr/bin/osascript -e 'display alert "无法启动素章" message "请确认 素章.app 位于项目根目录，且已完成安装（backend/.venv 与 scripts/lwb-launch 存在）。" as critical'
