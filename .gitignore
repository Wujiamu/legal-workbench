*.dump
*.sql
*.tar.gz
backup/
backups/
*.backup

# OCR 模型（体积大，由 install_ocr_models.py 安装）
var/models/
*.onnx

# 日志
*.log
logs/

# Python
backend/.venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# 前端
node_modules/
frontend/node_modules/
frontend/dist/
.vite/

# 插件包依赖（由 npm ci 生成；插件包本体随仓库分发）
plugins/**/node_modules/

# 本机验收证据、历史规则备份、视频演示工程与设计访谈临时产物（不随开源仓库发布）
.impeccable/
demo-video/
docs/backups/
docs/reports/

# 测试与验收临时产物
.pytest_cache/
htmlcov/
.coverage
coverage.xml
/tmp-corpus/
corpus/

# 编辑器与系统垃圾
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# 桌面安装包构建产物：绝不入库（体积大且含本机二进制）
# 注意：这里只忽略 packaging/ 下的 .app，仓库根目录已跟踪的 素章.app/ 不受影响。
packaging/build/
packaging/dist/
packaging/staging/
packaging/**/*.app/
*.dmg
*.exe
