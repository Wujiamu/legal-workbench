# Set secrets only in a local .env file with mode 0600 or the environment.
# Optional: PostgreSQL 18 binary directory for scripts/lwb
# LWB_PG_BIN=/opt/homebrew/opt/postgresql@18/bin
LWB_DATABASE_URL=
LWB_DATA_ROOT=var/data
LWB_IMPORT_ROOTS=
LWB_HOST=127.0.0.1
LWB_PORT=8765
LWB_OCR_MODEL_DIR=var/models
LWB_MAX_FILE_BYTES=2147483648
LWB_PARSE_TIMEOUT_SECONDS=120
LWB_MAX_IMAGE_PIXELS=50000000
